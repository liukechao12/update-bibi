generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OriginType {
  media
  xhs
  wb
  wx
  sph
  dy
  zh
  tb
  other
}

enum PublisherType {
  MEDIA
  SOCIAL
}

enum AuthorType {
  BLUE_V
  SELF_MEDIA
  PERSONAL
}

enum MediaRuleStatus {
  ACTIVE
  DISABLED
}

enum MediaRuleType {
  DOMAIN
  ACCOUNT
}

enum ImportType {
  PASTE
  EXCEL
  MANUAL
  API
}

enum BatchStatus {
  CREATED
  VALIDATING
  PENDING_PUSH
  PUSHING
  PARTIAL_SUCCESS
  SUCCESS
  FAILED
  CLOSED
}

enum RecordStatus {
  DRAFT
  VALIDATED
  PENDING_PUSH
  PUSHING
  SUCCESS
  FAILED
  RETRYING
  DUPLICATE
}

enum PushJobStatus {
  PENDING
  SENDING
  SUCCESS
  FAILED
  RETRYING
}

enum ExternalApiClientStatus {
  ACTIVE
  DISABLED
}

model User {
  id                  String              @id @default(cuid())
  username            String              @unique
  passwordHash        String
  displayName         String
  phone               String?
  email               String?
  department          String?
  status              UserStatus          @default(ACTIVE)
  accountType         String?             @default("social")
  lastLoginAt         DateTime?
  currentSessionId    String?             @unique
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  roles               UserRole[]
  createdBatches      DataBatch[]         @relation("BatchCreatedBy")
  createdDataRecords  DataRecord[]        @relation("RecordCreatedBy")
  createdPushJobs     PushJob[]           @relation("PushJobCreatedBy")
  auditLogs           AuditLog[]
  uploadedImportFiles ImportFile[]        @relation("UploadedBy")
  updatedConfigs      SystemConfig[]      @relation("UpdatedBy")
  mediaLibraries      MediaLibrary[]
  externalApiClients  ExternalApiClient[] @relation("ExternalApiClientCreatedBy")
}

model Role {
  id          String           @id @default(cuid())
  roleCode    String           @unique
  roleName    String
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       UserRole[]
  permissions RolePermission[]
}

model Permission {
  id         String           @id @default(cuid())
  permCode   String           @unique
  permName   String
  moduleName String
  createdAt  DateTime         @default(now())
  roles      RolePermission[]
}

model UserRole {
  id        String   @id @default(cuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model DataBatch {
  id               String       @id @default(cuid())
  batchNo          String       @unique
  importType       ImportType
  sourceFileName   String?
  sourceSheetName  String?
  totalCount       Int          @default(0)
  validCount       Int          @default(0)
  invalidCount     Int          @default(0)
  pushCount        Int          @default(0)
  successCount     Int          @default(0)
  failCount        Int          @default(0)
  status           BatchStatus  @default(CREATED)
  sourceDepartment String?
  createdById      String
  createdAt        DateTime     @default(now())
  pushedAt         DateTime?
  remark           String?      @db.Text
  createdBy        User         @relation("BatchCreatedBy", fields: [createdById], references: [id])
  records          DataRecord[]
  pushJobs         PushJob[]
  importFiles      ImportFile[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([sourceDepartment, createdAt])
}

model DataRecord {
  id               String        @id @default(cuid())
  batchId          String
  textId           String        @unique
  title            String        @db.Text
  text             String        @db.LongText
  publishTime      DateTime
  crawlTime        DateTime?
  author           String
  originType       OriginType
  publisherType    PublisherType @default(SOCIAL)
  authorType       AuthorType?
  url              String        @db.Text
  commentNum       Int
  forwardNum       Int?
  praiseNum        Int?
  viewNum          Int?
  tendency         String?
  rawSourceText    String?       @db.LongText
  sourceRowNo      Int?
  sourceName       String?
  sourceDepartment String?
  lastPluginClientId   String?
  lastPluginReceivedAt DateTime?
  recordStatus     RecordStatus  @default(DRAFT)
  isDuplicate      Boolean       @default(false)
  createdById      String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  batch            DataBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy        User          @relation("RecordCreatedBy", fields: [createdById], references: [id])
  pushItems        PushJobItem[]
  lastPluginClient ExternalApiClient? @relation(fields: [lastPluginClientId], references: [id], onDelete: SetNull)

  @@index([lastPluginReceivedAt, id])
  @@index([lastPluginClientId, lastPluginReceivedAt])
  @@index([createdById, recordStatus, createdAt])
  @@index([recordStatus, createdAt])
  @@index([createdAt])
  @@index([originType, publisherType])
  @@index([createdById, createdAt])
  @@index([sourceDepartment, createdAt])
  @@index([sourceName])
}

model PushJob {
  id            String        @id @default(cuid())
  batchId       String
  jobNo         String        @unique
  env           String
  endpoint      String
  version       String        @default("1")
  pushType      String        @default("CREATE")
  requestBody   Json
  responseBody  Json?
  httpStatus    Int?
  insertedCount Int           @default(0)
  failedCount   Int           @default(0)
  retryCount    Int           @default(0)
  nextRetryAt   DateTime?
  status        PushJobStatus @default(PENDING)
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  batch         DataBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("PushJobCreatedBy", fields: [createdById], references: [id])
  items         PushJobItem[]

  @@index([createdById, createdAt])
  @@index([status, createdAt])
  @@index([createdAt])
}

model PushJobItem {
  id                 String     @id @default(cuid())
  pushJobId          String
  recordId           String
  itemIndex          Int
  pushType           String     @default("CREATE")
  previousCommentNum Int?
  previousForwardNum Int?
  previousPraiseNum  Int?
  previousViewNum    Int?
  status             String
  errorMessage       String?    @db.Text
  vendorResponseCode String?    @db.Text
  createdAt          DateTime   @default(now())
  pushJob            PushJob    @relation(fields: [pushJobId], references: [id], onDelete: Cascade)
  record             DataRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@unique([pushJobId, itemIndex])
  @@index([recordId, status])
}

model ImportFile {
  id           String     @id @default(cuid())
  fileName     String
  filePath     String
  fileSize     BigInt
  fileHash     String
  batchId      String?
  uploadedById String?
  createdAt    DateTime   @default(now())
  batch        DataBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  uploadedBy   User?      @relation("UploadedBy", fields: [uploadedById], references: [id], onDelete: SetNull)
}

model SystemConfig {
  id          String   @id @default(cuid())
  configKey   String   @unique
  configValue String   @db.LongText
  configType  String   @default("STRING")
  updatedById String?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
  updatedBy   User?    @relation("UpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  actionType  String
  module      String
  targetId    String?
  actionDesc  String
  requestData Json?
  resultData  Json?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaLibrary {
  id            String          @id @default(cuid())
  name          String
  domain        String?
  authorName    String?
  originType    OriginType
  publisherType PublisherType
  authorType    AuthorType?
  ruleType      MediaRuleType   @default(DOMAIN)
  rulePattern   String?
  priority      Int             @default(0)
  status        MediaRuleStatus @default(ACTIVE)
  remark        String?         @db.Text
  createdById   String
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  createdBy     User            @relation(fields: [createdById], references: [id])

  @@index([domain, authorName])
}

model EventRecord {
  id             String    @id @default(cuid())
  category       String
  sourceFileName String
  seqNo          Int
  source         String?
  author         String?
  fansCount      Int       @default(0)
  authType       String?
  publishTime    DateTime?
  title          String?   @db.Text
  link           String?   @db.Text
  summary        String?   @db.Text
  viewCount      Int?
  forwardCount   Int?
  replyCount     Int?
  praiseCount    Int?
  tendency       String?
  rawData        Json?
  rowNo          Int
  createdAt      DateTime  @default(now())

  @@index([category, publishTime, id])
  @@index([category, createdAt])
  @@index([source])
  @@index([author])
  @@index([publishTime])
  @@index([createdAt])
}

model ExternalApiClient {
  id                 String                        @id @default(cuid())
  clientCode         String                        @unique
  clientName         String
  department         String?
  apiKeyHash         String                        @unique
  status             ExternalApiClientStatus       @default(ACTIVE)
  allowAllEvents     Boolean                       @default(false)
  rateLimitPerMinute Int                           @default(60)
  expiresAt          DateTime?
  lastUsedAt         DateTime?
  createdById        String
  createdAt          DateTime                      @default(now())
  updatedAt          DateTime                      @updatedAt
  createdBy          User                          @relation("ExternalApiClientCreatedBy", fields: [createdById], references: [id])
  eventScopes        ExternalApiClientEventScope[]
  requestLogs        ExternalApiRequestLog[]
  pluginRecords      DataRecord[]

  @@index([status, createdAt])
  @@index([department, createdAt])
}

model ExternalApiClientEventScope {
  id            String            @id @default(cuid())
  clientId      String
  eventCategory String
  createdAt     DateTime          @default(now())
  client        ExternalApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, eventCategory])
  @@index([eventCategory])
}

model ExternalApiRequestLog {
  id            String            @id @default(cuid())
  clientId      String
  path          String
  method        String
  requestIp     String?
  requestQuery  Json?
  responseCode  Int
  responseCount Int               @default(0)
  costMs        Int               @default(0)
  createdAt     DateTime          @default(now())
  client        ExternalApiClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
  @@index([path, createdAt])
}

model MediaMetricCapability {
  id                 String   @id @default(cuid())
  sourceName         String   @unique
  category           String?
  commentCollectable Boolean  @default(false)
  forwardCollectable Boolean  @default(false)
  praiseCollectable  Boolean  @default(false)
  remark             String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model DocumentSyncLog {
  id           String    @id @default(cuid())
  triggerType  String
  sourceUrl    String    @db.Text
  status       String
  totalRows    Int       @default(0)
  createdCount Int       @default(0)
  updatedCount Int       @default(0)
  skippedCount Int       @default(0)
  invalidCount Int       @default(0)
  pushedCount  Int       @default(0)
  failedCount  Int       @default(0)
  details      Json?
  errorMessage String?   @db.Text
  startedAt    DateTime  @default(now())
  finishedAt   DateTime?

  @@index([startedAt])
  @@index([status, startedAt])
}

model WeiboHotTopic {
  id              String   @id @default(cuid())
  batchAt         DateTime
  channel         String   @default("热搜")
  rank            Int
  word            String
  note            String?
  category        String?
  subjectQuerys   String?
  labelName       String?
  hotNum          Int      @default(0)
  onboardTime     DateTime?
  content         String?  @db.Text
  matched         Boolean  @default(false)
  matchedKeywords String?
  createdAt       DateTime @default(now())

  @@index([batchAt])
  @@index([batchAt, channel])
  @@index([matched, batchAt])
}

// 微信推送去重状态：每个 word+channel 记录最近一次推送时的排名
model WeiboHotNotify {
  id             String   @id @default(cuid())
  word           String
  channel        String
  firstSeenAt    DateTime
  lastPushedRank Int
  lastPushedAt   DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([word, channel])
}
